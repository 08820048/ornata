{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ornata",
  "version": "0.7.0",
  "identifier": "app.ornata",
  "build": {
    "beforeDevCommand": "bun run agent:build && bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run agent:build && bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ornata",
        "width": 1656,
        "height": 1180,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "maximized": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "decorations": true,
        "transparent": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; font-src 'self'; img-src 'self' asset: http://asset.localhost data: https:; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "active": true,
    "externalBin": [
      "binaries/ornata-agent"
    ],
    "targets": "all",
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown Document",
        "description": "Markdown document",
        "role": "Editor",
        "rank": "Alternate"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "category": "Productivity",
    "shortDescription": "A fast, local-first notes app for developers and content creators",
    "longDescription": "Ornata is a macOS-first, local-only, ultra high-performance notes app designed for developers and content creators who care deeply about speed, privacy, and data ownership.",
    "macOS": {
      "entitlements": "./Entitlements.plist",
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "windowPosition": {
          "x": 400,
          "y": 400
        },
        "appPosition": {
          "x": 180,
          "y": 220
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 220
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://download.ornata.app/products/ornata-markd/channels/stable/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQxNURFMUQ0NEJDMDlDNzcKUldSM25NQkwxT0ZkUWJrL1JZdjUyVnUyK2xxM2YxcHlraTIvUS9zN2dZYmVTcHdFZTZUbE9HTGcK"
    }
  }
}
