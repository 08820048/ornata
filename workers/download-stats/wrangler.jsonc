{
  "$schema": "../../site/node_modules/wrangler/config-schema.json",
  "name": "ornata-downloads",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-01",
  // Also reachable on workers.dev, which is how a change is compared with the live domain first (README.md).
  "workers_dev": true,
  "routes": [{ "pattern": "download.ornata.app/*", "zone_name": "ornata.app" }],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "ornata" }],
  "analytics_engine_datasets": [{ "binding": "STATS", "dataset": "ornata_downloads" }]
}
